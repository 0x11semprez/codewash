# Copy this file to .env.local and fill in the values you need.
# Vite reads them at build time. Restart `npm run dev` after a change.

# Bug reports: where the "Report a bug" form sends reports.
# If an endpoint is set, reports are sent there as a multipart POST (with files).
# Otherwise the player's mail app opens with a prefilled email to this address.
# Leave both empty to open the mail app with no recipient.
VITE_BUG_REPORT_ENDPOINT=
VITE_BUG_REPORT_EMAIL=
